# Copy this file to  .streamlit/secrets.toml  and fill in the values. NEVER commit secrets.toml.
# 1. Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
# 2. Authorised redirect URI:  http://localhost:8501/oauth2callback
#    (for your live site use  https://YOUR-DOMAIN/oauth2callback  and add it as a second URI)

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
